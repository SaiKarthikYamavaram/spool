{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        { "path": "$DOWNLOAD/**" },
        { "path": "/media/**" },
        { "path": "/run/media/**" },
        { "path": "/mnt/**" }
      ]
    },
    "opener:allow-reveal-item-in-dir",
    "dialog:default",
    "dialog:allow-open",
    "notification:default"
  ]
}
