{
  "manifest_version": 3,
  "name": "spool integration",
  "version": "1.5.0",
  "key": "",
  "description": "Send downloads to spool with the browser's cookies. Detects media on a page, grabs all links or images, and routes captured downloads by file type.",
  "permissions": [
    "cookies",
    "contextMenus",
    "downloads",
    "nativeMessaging",
    "notifications",
    "storage",
    "webRequest",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "spool",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "commands": {
    "grab-video": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y"
      },
      "description": "Download this page's video with spool"
    }
  }
}
